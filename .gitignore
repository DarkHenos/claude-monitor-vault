# Build artifacts: the .vsix packages are produced by the packaging script
*.vsix
*.vsix.bak

# Dev dependencies only: the extension itself ships with zero runtime
# dependency, so nothing here belongs in the repository (97 MB of it).
node_modules/

# What the vault itself writes. None of these belongs in a working tree, but a
# CLAUDE_CONFIG_DIR pointed here, or an export saved in the wrong folder, would
# put one right next to the code. An extension whose whole point is not leaking
# secrets should not be one careless save away from committing its own.
*.cvault
vault.json
masterkey.bin
recovery.bin
recovery-log.bin
trash.json
policy.json
pending-*.json
ui-lang.json

# Credentials of any shape
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# OS and editor noise
.DS_Store
Thumbs.db

# JetBrains plugin build output (intellij/)
intellij/build/
intellij/.gradle/
intellij/.intellijPlatform/
intellij/.kotlin/

# Written by Claude Code each time it loads the pane from this folder.
vault-pane/.claude-plugin/types/
