{
  "name": "claude-monitor-vault",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "1.0.0",
  "l10n": "./l10n",
  "publisher": "alexossart",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DarkHenos/claude-monitor-vault.git"
  },
  "bugs": {
    "url": "https://github.com/DarkHenos/claude-monitor-vault/issues"
  },
  "homepage": "https://github.com/DarkHenos/claude-monitor-vault#readme",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "qna": false,
  "keywords": [
    "claude",
    "claude monitor",
    "claude code",
    "claude companion",
    "anthropic",
    "rate limit",
    "usage",
    "quota",
    "limits",
    "credits",
    "secrets",
    "vault",
    "api keys",
    "mcp"
  ],
  "galleryBanner": {
    "color": "#D97757",
    "theme": "dark"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%cap.untrusted%"
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeMonitorVault",
          "title": "%view.container%",
          "icon": "media/activity-bar.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "claudeMonitorVaultAux",
          "title": "%view.container%",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "claudeMonitorVault": [
        {
          "type": "webview",
          "id": "claudeMonitorVault.panel",
          "name": "%view.panel%",
          "when": "!claudeLimits.inSecondary"
        },
        {
          "id": "claudeMonitorVault.summary",
          "name": "%view.panel%",
          "when": "claudeLimits.inSecondary",
          "visibility": "collapsed"
        }
      ],
      "claudeMonitorVaultAux": [
        {
          "type": "webview",
          "id": "claudeMonitorVaultAux.panel",
          "name": "%view.panel%",
          "when": "claudeLimits.inSecondary"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeLimits.open",
        "category": "%cat.limits%",
        "title": "%cmd.open%",
        "icon": "$(sparkle)"
      },
      {
        "command": "claudeLimits.refresh",
        "category": "%cat.limits%",
        "title": "%cmd.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeLimits.moveToSecondary",
        "category": "%cat.limits%",
        "title": "%cmd.moveToSecondary%",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "claudeLimits.moveToPrimary",
        "category": "%cat.limits%",
        "title": "%cmd.moveToPrimary%",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "claudeLimits.pillColor",
        "category": "%cat.limits%",
        "title": "%cmd.pillColor%",
        "icon": "$(paintcan)"
      },
      {
        "command": "claudeVault.show",
        "category": "%cat.vault%",
        "title": "%cmd.vault.show%",
        "icon": "$(lock)"
      },
      {
        "command": "claudeVault.add",
        "category": "%cat.vault%",
        "title": "%cmd.vault.add%",
        "icon": "$(add)"
      },
      {
        "command": "claudeVault.delete",
        "category": "%cat.vault%",
        "title": "%cmd.vault.delete%",
        "icon": "$(trash)"
      },
      {
        "command": "claudeVault.setTtl",
        "category": "%cat.vault%",
        "title": "%cmd.vault.setTtl%",
        "icon": "$(clock)"
      },
      {
        "command": "claudeVault.copyMarker",
        "category": "%cat.vault%",
        "title": "%cmd.vault.copyMarker%",
        "icon": "$(copy)"
      },
      {
        "command": "claudeVault.reveal",
        "category": "%cat.vault%",
        "title": "%cmd.vault.reveal%",
        "icon": "$(eye)"
      },
      {
        "command": "claudeVault.toggleMcp",
        "category": "%cat.vault%",
        "title": "%cmd.vault.toggleMcp%",
        "icon": "$(plug)"
      },
      {
        "command": "claudeVault.actions",
        "category": "%cat.vault%",
        "title": "%cmd.vault.actions%",
        "icon": "$(list-selection)"
      },
      {
        "command": "claudeVault.settings",
        "category": "%cat.vault%",
        "title": "%cmd.vault.settings%",
        "icon": "$(gear)"
      },
      {
        "command": "claudeVault.audit",
        "category": "%cat.vault%",
        "title": "%cmd.vault.audit%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "claudeVault.connect",
        "category": "%cat.vault%",
        "title": "%cmd.vault.connect%",
        "icon": "$(plug)"
      },
      {
        "command": "claudeVault.disconnect",
        "category": "%cat.vault%",
        "title": "%cmd.vault.disconnect%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "claudeVault.revokeAll",
        "category": "%cat.vault%",
        "title": "%cmd.vault.revokeAll%",
        "icon": "$(alert)"
      },
      {
        "command": "claudeVault.details",
        "category": "%cat.vault%",
        "title": "%cmd.vault.details%",
        "icon": "$(info)"
      },
      {
        "command": "claudeVault.setNote",
        "category": "%cat.vault%",
        "title": "%cmd.vault.setNote%",
        "icon": "$(edit)"
      },
      {
        "command": "claudeVault.rename",
        "category": "%cat.vault%",
        "title": "%cmd.vault.rename%",
        "icon": "$(edit)"
      },
      {
        "command": "claudeVault.replace",
        "category": "%cat.vault%",
        "title": "%cmd.vault.replace%",
        "icon": "$(key)"
      },
      {
        "command": "claudeVault.trash",
        "category": "%cat.vault%",
        "title": "%cmd.vault.trash%",
        "icon": "$(trash)"
      },
      {
        "command": "claudeVault.checkCommit",
        "category": "%cat.vault%",
        "title": "%cmd.vault.checkCommit%",
        "icon": "$(shield)"
      },
      {
        "command": "claudeVault.terminal",
        "category": "%cat.vault%",
        "title": "%cmd.vault.terminal%",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeVault.export",
        "category": "%cat.vault%",
        "title": "%cmd.vault.export%",
        "icon": "$(save)"
      },
      {
        "command": "claudeVault.import",
        "category": "%cat.vault%",
        "title": "%cmd.vault.import%",
        "icon": "$(history)"
      },
      {
        "command": "claudeVault.togglePublic",
        "category": "%cat.vault%",
        "title": "%cmd.vault.togglePublic%",
        "icon": "$(globe)"
      },
      {
        "command": "claudeVault.toggleConfirm",
        "category": "%cat.vault%",
        "title": "%cmd.vault.toggleConfirm%",
        "icon": "$(bell)"
      },
      {
        "command": "claudeVault.recovery",
        "category": "%cat.vault%",
        "title": "%cmd.vault.recovery%",
        "icon": "$(shield)"
      },
      {
        "command": "claudeVault.recoveryRestore",
        "category": "%cat.vault%",
        "title": "%cmd.vault.recoveryRestore%",
        "icon": "$(history)"
      },
      {
        "command": "claudeVault.autoApprove",
        "category": "%cat.vault%",
        "title": "%cmd.vault.autoApprove%",
        "icon": "$(unlock)"
      },
      {
        "command": "claudeVault.mcpSnippet",
        "category": "%cat.vault%",
        "title": "%cmd.vault.mcpSnippet%",
        "icon": "$(server)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeVault.settings",
          "when": "view == claudeMonitorVault.panel || view == claudeMonitorVaultAux.panel",
          "group": "navigation@1"
        },
        {
          "command": "claudeLimits.refresh",
          "when": "view == claudeMonitorVault.panel || view == claudeMonitorVaultAux.panel || view == claudeMonitorVault.summary",
          "group": "navigation@2"
        },
        {
          "command": "claudeLimits.moveToSecondary",
          "when": "view == claudeMonitorVault.panel",
          "group": "navigation@3"
        },
        {
          "command": "claudeLimits.moveToPrimary",
          "when": "view == claudeMonitorVaultAux.panel || view == claudeMonitorVault.summary",
          "group": "navigation@3"
        },
        {
          "command": "claudeLimits.pillColor",
          "when": "view == claudeMonitorVault.panel || view == claudeMonitorVaultAux.panel || view == claudeMonitorVault.summary",
          "group": "9_apparence@1"
        }
      ],
      "webview/context": [
        {
          "command": "claudeVault.copyMarker",
          "when": "webviewSection == 'vaultKey'",
          "group": "1_usage@1"
        },
        {
          "command": "claudeVault.details",
          "when": "webviewSection == 'vaultKey'",
          "group": "1_usage@0"
        },
        {
          "command": "claudeVault.rename",
          "when": "webviewSection == 'vaultKey'",
          "group": "2_acces@1"
        },
        {
          "command": "claudeVault.replace",
          "when": "webviewSection == 'vaultKey'",
          "group": "2_acces@2"
        },
        {
          "command": "claudeVault.setNote",
          "when": "webviewSection == 'vaultKey'",
          "group": "2_acces@0"
        },
        {
          "command": "claudeVault.setTtl",
          "when": "webviewSection == 'vaultKey'",
          "group": "1_usage@2"
        },
        {
          "command": "claudeVault.toggleMcp",
          "when": "webviewSection == 'vaultKey'",
          "group": "2_acces@1"
        },
        {
          "command": "claudeVault.reveal",
          "when": "webviewSection == 'vaultKey'",
          "group": "2_acces@2"
        },
        {
          "command": "claudeVault.delete",
          "when": "webviewSection == 'vaultKey'",
          "group": "3_danger@1"
        },
        {
          "command": "claudeVault.mcpSnippet",
          "when": "webviewSection == 'vaultKey'",
          "group": "2_acces@3"
        }
      ]
    },
    "configuration": {
      "title": "%cat.limits%",
      "properties": {
        "claudeLimits.pollSeconds": {
          "type": "number",
          "default": 210,
          "minimum": 120,
          "description": "%cfg.pollSeconds%"
        },
        "claudeLimits.alerts": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.alerts%"
        },
        "claudeLimits.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.statusBar%"
        },
        "claudeLimits.badge": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.badge%"
        },
        "claudeLimits.location": {
          "type": "string",
          "enum": [
            "sidebar",
            "secondarySidebar"
          ],
          "default": "secondarySidebar",
          "description": "%cfg.location%"
        },
        "claudeLimits.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoConnect%"
        },
        "claudeLimits.statusBarPosition": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "description": "%cfg.statusBarPosition%"
        },
        "claudeLimits.statusBarStyle": {
          "type": "string",
          "enum": [
            "prominent",
            "subtle"
          ],
          "enumDescriptions": [
            "%cfg.statusBarStyle.prominent%",
            "%cfg.statusBarStyle.subtle%"
          ],
          "default": "prominent",
          "description": "%cfg.statusBarStyle%"
        },
        "claudeLimits.statusBarBands": {
          "type": "array",
          "default": [
            { "upTo": 50, "color": "descriptionForeground" },
            { "upTo": 75, "color": "foreground" },
            { "upTo": 90, "color": "charts.yellow" },
            { "upTo": 100, "color": "charts.red" }
          ],
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "upTo",
              "color"
            ],
            "properties": {
              "upTo": {
                "type": "number",
                "minimum": 1,
                "maximum": 100,
                "description": "%cfg.statusBarBands.upTo%"
              },
              "color": {
                "type": "string",
                "enum": [
                  "descriptionForeground",
                  "foreground",
                  "charts.blue",
                  "charts.green",
                  "charts.purple",
                  "charts.orange",
                  "charts.yellow",
                  "charts.red",
                  "errorForeground"
                ],
                "description": "%cfg.statusBarBands.color%"
              }
            }
          },
          "markdownDescription": "%cfg.statusBarBands%"
        },
        "claudeLimits.statusBarWeek": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.statusBarWeek%"
        },
        "claudeLimits.pauseWhenExhausted": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.pauseWhenExhausted%"
        },
        "claudeLimits.showCredits": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showCredits%"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "claudeMonitorVault.summary",
        "contents": "%welcome.movedRight%"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
